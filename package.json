{
  "name": "rift-buddy",
  "productName": "开黑搭子",
  "version": "0.59.33",
  "description": "英雄联盟开黑助手：阵容推荐、一键配置、房间协作与局内参考",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.25.0"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/build-renderer.mjs && electron .",
    "build:renderer": "node scripts/build-renderer.mjs",
    "smoke:vue": "node scripts/build-renderer.mjs && node scripts/smoke-vue-routes.mjs",
    "preview": "node scripts/preview.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "test": "node scripts/build-renderer.mjs && node --test --test-concurrency=4 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "sync-builds": "node scripts/sync-builds.mjs --all-roles",
    "catalog:expand": "node scripts/expand-catalog.mjs",
    "spells:enrich": "node scripts/enrich-spells.mjs",
    "installer": "node scripts/installer.mjs",
    "installer:delta": "node scripts/package-delta-update.mjs",
    "sync-pairs": "node scripts/sync-pair-statistics.mjs",
    "sync-rankings": "node scripts/sync-rankings.mjs",
    "sync-abilities": "node scripts/sync-abilities.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vue/compiler-sfc": "3.5.44",
    "electron": "44.5.1",
    "vue": "3.5.44"
  }
}
