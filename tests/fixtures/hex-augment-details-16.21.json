  "entries": {
    "kiwi_bonk_summary": "被【{{SpellName}}】技能强化的攻击或技能会对目标和附近的敌人们造成额外伤害。",
    "kiwi_bonk_tooltip": "被【{{SpellName}}】技能强化的攻击或技能会对目标和附近的敌人们造成额外的@DamageMultiplier*100@%伤害。<br><br>被“邦”的额外英雄数量：@f1@",
    "cherry_backtobasics_summary": "获得提升过的技能伤害、<healing>治疗效果</healing>、<shield>护盾</shield>和<scaleAbilityHaste>技能急速</scaleAbilityHaste>，但你<keywordMajor>不能使用你的终极技能</keywordMajor>。",
    "cherry_backtobasics_tooltip": "你的终极技能已被封印。获得@DamageAmp*100@%技能伤害、<healing>治疗效果</healing>、<shield>护盾</shield>和<scaleAbilityHaste>@Haste@技能急速</scaleAbilityHaste>。",
    "kiwi_upgrade_sheen_summary": "你的<passive>咒刃</passive>效果造成<physical>额外伤害</physical>并<heal>治疗</heal>你自身，治疗量相当于目标生命值的一定百分比。此外，获得<gold>250金币</gold>。",
    "kiwi_upgrade_sheen_tooltip": "你的<passive>咒刃</passive>效果造成相当于目标@DamageMaxHP*100@%生命值的<physicalDamage>额外伤害</physicalDamage>，并<healing>治疗</healing>你自身，治疗效果相当于目标@HealMaxHP*100@%生命值。此外，获得<gold>250金币</gold>。<br><br>已造成的伤害：@f1@<br>已造成的治疗总和：@f2@",
    "spellname": "<font color='#F0C200'>@SpellName@</font>"
  }
