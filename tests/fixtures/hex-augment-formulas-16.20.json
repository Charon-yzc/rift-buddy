  "entries": {
    "cherry_jeweledgauntlet_summary": "你的技能可以造成<crit>暴击</crit>。<br><br>获得<crit>%i:scaleCrit% @CritGranted@暴击几率</crit>。",
    "kiwi_zealot_summary": "获得<attention>@Calc_Crit_Chance@暴击几率</attention>和<attackSpeed>@Calc_AS@攻击速度</attackSpeed>（随法术强度变化）。",
    "kiwi_empyreanpromise_summary": "获得%i:scaleHealShield%@HSAmp*100@%治疗和护盾强度。获得<spellName>至高天诺言</spellName>作为一个召唤师技能。<br><br><rules><active>警惕</active><br>传送至你的友军并在着陆时提供持续@ShieldDuration@秒的<shield>@ShieldAmount@护盾值</shield>。</rules>",
    "augment_warlockjuicebox_summary": "获得<lifeSteal>@Calc_Vamp@全能吸血</lifeSteal>。",
    "augment_specializedrecursion_desc": "<font color='#F0C200'>任务：</font>用【{{SpellName}}】技能命中敌方英雄@QuestRequirement@次<br><br><font color='#F0C200'>奖励：</font>【{{SpellName}}】技能获得技能急速，基于任务等级，至多至@MaxAbilityHasteReward@。",
    "spellname": "<font color='#F0C200'>@SpellName@</font>",
    "cherry_okboomerang_summary": "每@Cooldown@秒朝着一个附近的敌人<keywordMajor>自动施放</keywordMajor>投掷一个回力镖。",
    "kiwi_twinfire_summary": "造成技能伤害时，发射1+@AdditionalMis@个飞弹，每个造成<magicDamage>@Damage@魔法伤害</magicDamage>。<br><br>此外，获得<attention>%i:scaleCrit%@CrtiChance*100@%暴击几率</attention>。"
  }
}
