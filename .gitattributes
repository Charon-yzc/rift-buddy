# Stable text bytes keep Windows checkouts from inflating incremental updates.
# This also preserves the generated Akari bytes hashed in manifest.json.
*.mjs text eol=lf
*.cjs text eol=lf
*.cs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
